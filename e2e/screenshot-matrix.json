{
  "prefix": "exp",
  "outDir": "craft/web",
  "viewports": [
    {
      "name": "mobile",
      "width": 320,
      "height": 800
    },
    {
      "name": "tablet",
      "width": 768,
      "height": 800
    },
    {
      "name": "desktop",
      "width": 1280,
      "height": 800
    }
  ],
  "surfaces": [
    {
      "id": "index",
      "path": "/",
      "ready": "section[data-exp-view='index']",
      "states": [
        "populated"
      ],
      "dark": true
    },
    {
      "id": "claims",
      "path": "/claims",
      "ready": "section[data-exp-view='claims']",
      "listSel": "#exp-claims-list",
      "states": [
        "populated",
        "empty"
      ],
      "emptyDriver": "statusFilter",
      "filterSel": "[data-exp-filter=\"status\"]",
      "dark": true
    },
    {
      "id": "claim-new",
      "path": "/claims/new",
      "ready": "section[data-exp-view='claim-form']",
      "states": [
        "current"
      ],
      "dark": true
    },
    {
